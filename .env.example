# Discord MCP Server (Discp) Configuration

# Account Type: 'user' (selfbot/alt account) or 'bot' (official Discord bot token)
DISCORD_ACCOUNT_TYPE=user

# Your Discord Token (Bot token or User account token)
DISCORD_TOKEN=your_discord_token_here

# Default Server ID (Optional: commands will default to this guild if guildId is not provided)
DISCORD_GUILD_ID=your_default_server_id_here

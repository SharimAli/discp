{
  "name": "discp",
  "version": "1.0.0",
  "description": "Production-grade, feature-complete Discord MCP Server for AI assistants",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "discp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "generate-schemas": "node scripts/generate_schemas.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "discord",
    "discord-mcp",
    "discord-bot",
    "discord-api",
    "discord-selfbot",
    "claude",
    "claude-desktop",
    "claude-code",
    "cursor",
    "cursor-ai",
    "antigravity",
    "opencode",
    "windsurf",
    "ai-agents",
    "autonomous-agents",
    "llm",
    "anthropic"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "discord.js": "^14.18.0",
    "discord.js-selfbot-v13": "^3.7.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
